# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Get paper-trading keys at https://app.alpaca.markets (Paper Trading -> API Keys).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Optional: the low-risk paper account (currently runs the AI analyst experiment).
ALPACA_SAFE_API_KEY=
ALPACA_SAFE_SECRET_KEY=
# Optional: for the AI analyst (https://console.anthropic.com). Paid per use; set a spend limit there.
ANTHROPIC_API_KEY=
# Optional: a paper account for the aggressive lab strategy.
ALPACA_LAB_API_KEY=
ALPACA_LAB_SECRET_KEY=
# Leave unset (paper). "live" also requires live.enabled = true in config.toml.
TRADING_MODE=
